<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <!-- Menu Dashboards -->
        <menuitem name="Dashboards" id="menu_dashboards"
                  parent="menu_root" sequence="86"/>

        <!-- Vistes de diferents Action -->
        <record model="ir.ui.view" id="school_teacher_board">
            <field name="name">school.teacher.board</field>
            <field name="model">board.board</field>
            <field name="arch" type="xml">
                <form>
                    <board style="1-1">
                        <column>
                            <action string="Teachers"
                                    name="%(school_teacher_action_no_manager)d"/>
                            
                            <action string="Teachers Female"
                                    name="%(school_teacher_action_no_manager)d"
                                    domain="[('gender', '=', 'female')]"/>
                            
                            <action string="Teachers Male"
                                    name="%(school_teacher_action_no_manager)d"
                                    domain="[('gender', '=', 'male')]"/>
                        </column>

                        <column>
                            <action string="Teaching"
                                    name="%(school_teaching_action)d"/>
                            
                            <action string="Teachers Salary History"
                                    name="%(school_teacher_salary_history_action)d"/>
                            
                            <action string="Teachers Salary Graph"
                                    name="%(school_teacher_action_manager)d"
                                    view_mode="graph"/>
                        </column>
                    </board>
                </form>
            </field>
        </record>

        <!-- Action Dashboard -->
        <record model="ir.actions.act_window" id="action_board_teacher">
            <field name="name">Teachers Dashboard</field>
            <field name="res_model">board.board</field>
            <field name="view_mode">form</field>
            <field name="usage">menu</field>
            <field name="view_id" ref="school_teacher_board"/>
        </record>

        <!-- Submenu Dashboard -->
         <menuitem name="Teachers" id="menu_board_teacher"
                   parent="menu_dashboards" action="action_board_teacher"/>
    
    </data>
</odoo>
